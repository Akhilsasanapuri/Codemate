# Copy to .env and fill in.
#
# === Google Gemini (default — free tier) ===
# Get a key: https://aistudio.google.com/apikey
LLM_API_KEY=replace-me
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash-lite
# Other Gemini options: gemini-2.5-flash (smarter), gemini-flash-lite-latest,
# gemini-2.0-flash-lite. Note: gemini-2.0-flash sometimes requires billing enabled.
#
# === Other OpenAI-compatible providers (swap the 3 vars above) ===
# OpenAI:    LLM_BASE_URL=https://api.openai.com/v1                LLM_MODEL=gpt-4o-mini
# Groq:      LLM_BASE_URL=https://api.groq.com/openai/v1           LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter:LLM_BASE_URL=https://openrouter.ai/api/v1             LLM_MODEL=deepseek/deepseek-chat:free
# Ollama:    LLM_BASE_URL=http://localhost:11434/v1                LLM_MODEL=qwen2.5-coder

DB_URL=sqlite:///./codemate.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LLM_TIMEOUT_SECONDS=30

# === RAG / Codebase Whisperer ===
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
CHROMA_DIR=./chroma_db
RAG_TOP_K=6
MAX_FILE_BYTES=102400
MAX_FILES_PER_PROJECT=500
MAX_CHUNKS_PER_PROJECT=2000
